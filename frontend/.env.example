# Optional deployed FastAPI service root (e.g. https://your-service.onrender.com).
# Set this in Vercel Project Settings and redeploy, or enter it in app Settings.
VITE_API_URL=

# Local FastAPI origin only; leave blank in local Vite development (the /api
# proxy is used). Do not include a trailing /api path.
VITE_LOCAL_API_URL=
